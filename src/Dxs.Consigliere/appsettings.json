{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "System": "Information",
        "Microsoft": "Warning",
        "TrustMargin.Api.Auth": "Debug",
        "System.Net.Http.HttpClient": "Warning",
        "Microsoft.AspNetCore.Identity": "Information",
        "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "Fatal"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:HH:mm:ss.fffzzz} [{Level:u3}] [{SourceContext:l}]{Scope:l} {Message}{NewLine}{Exception}"
        }
      }
    ]
  },
  "BackgroundTasks": {
    "DisabledTasks": [
      // JungleBus is a BSV-only SaaS mempool/sync source with no Radiant
      // equivalent. Disabled; replace with a Radiant-node / RXinDexer source.
      "JungleBusMempoolMonitor",
      "JungleBusSyncMissingDataBackgroundTask",
      // UnconfirmedTransactionsMonitor reconciles the mempool via the BSV SaaS
      // (WhatsOnChain + Bitails). Disabled on Radiant — unconfirmed txs already
      // arrive over ZMQ (RawTx2Address). Re-enable once reimplemented against the
      // Radiant node RPC. See RADIANT_ADAPTATION.md.
      "UnconfirmedTransactionsMonitor"
    ],
    "EnabledTasks": [
      "AppInitBackgroundTask",
      "ActualChainTipVerifyBackgroundTask",
      "BlockProcessBackgroundTask",
      // STAS attribute tasks are the BSV token seam. They no-op without watched
      // STAS tokens and will be replaced by Glyph indexing (see RADIANT_ADAPTATION.md).
      "StasAttributesChangeObserverTask",
      "StasAttributesMissingTransactions"
    ]
  },
  "RavenDb": {
    "Urls": ["http://localhost:8080"],
    "DbName": "Consigliere"
    // For production environment
    // "ClientCertificate": "[path to certificate].pfx",
    // "CertificatePassword": "[password for certificate if any]"
  },
  // "Mainnet" or "Testnet". Radiant regtest shares testnet address/key params,
  // so target a regtest node with "Testnet" and point RadiantNodeApi at it.
  "Network": "Mainnet",
  "ScanMempoolOnStart": true,
  "BlockCountToScanOnStart": 2,
  "ZmqClient": {
    // Radiant node ZMQ publishers (set with -zmqpub* in radiant.conf).
    "RawTx2Address": "tcp://[Radiant node address or domain]:28332",
    "RemovedFromMempoolBlockAddress": "tcp://[Radiant node address or domain]:28332",
    "DiscardedFromMempoolAddress": "tcp://[Radiant node address or domain]:28332",
    "HashBlock2Address": "tcp://[Radiant node address or domain]:28332"
  },
  "RadiantNodeApi": {
    // Radiant node JSON-RPC. Default RPC ports: mainnet 7332, testnet 27332,
    // regtest 17443 (Radiant-Core v3).
    "BaseUrl": "http://[Radiant node address or domain]:7332",
    "User": "[Radiant node rpc user]",
    "Password": "[Radiant node rpc password]"
  },
  "TransactionFilter": {
    "Addresses": [
      // Radiant (RXD) addresses to watch. Consigliere builds a selective index of
      // all new transactions touching these addresses for every output type it
      // recognizes (currently P2PKH; Glyph ref outputs are planned — see roadmap).
    ],
    "Tokens": [
      // Reserved for Glyph token refs once Glyph indexing lands (replaces the
      // BSV STAS token id list). Leave empty for plain RXD payment indexing.
    ]
  },
  "JungleBus": {
    // BSV-only SaaS. Kept disabled; no Radiant equivalent.
    "Enabled": false,
    "BlockSubscriptionId": "",
    "MempoolSubscriptionId": ""
  }
}
